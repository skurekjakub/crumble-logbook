#!/usr/bin/env bash
# PreToolUse hook matching Bash. Steers whole-repo quality-gate runs toward
# `pnpm verify` by exiting 2 (Claude Code's "deny" signal for PreToolUse).
# Pass-through (exit 0) for anything else.
#
# The point is to stop the "run the gates by hand" pattern without breaking the
# tight debugging loop, so the rules are deliberately narrow:
#
#   1. Two or more gates chained in one command  -> blocked. That is verify's job.
#   2. An unscoped whole-repo run of a gate that HAS a scoped form
#      (test, lint, format:check)               -> blocked. Scope it or verify.
#   3. A lone typecheck or build                 -> allowed. Each is a
#      legitimate single check.
#
# Matching is anchored to the whole segment, so any extra argument — a path, a
# filter, `--` passthrough — falls through as a scoped run and is allowed.

set -euo pipefail

input=$(cat)
cmd=$(echo "$input" | jq -r '.tool_input.command // ""' 2>/dev/null || echo "")

if [ -z "$cmd" ]; then
    exit 0
fi

# Classify one command segment as a gate, or empty string when it is not one.
gate_of() {
    # rtk proxies bare dev commands, so the same gate can arrive either way.
    local seg="${1#rtk }"
    case "$seg" in
    'pnpm typecheck' | 'pnpm run typecheck' | 'pnpm -r typecheck' | 'pnpm exec tsc -p .' | 'tsc -p .') echo typecheck ;;
    'pnpm lint' | 'pnpm run lint' | 'pnpm exec eslint .' | 'pnpm exec eslint --max-warnings 0 .' | 'eslint .') echo lint ;;
    'pnpm format:check' | 'pnpm run format:check' | 'pnpm exec prettier --check .' | 'prettier --check .') echo format ;;
    'pnpm test' | 'pnpm run test' | 'pnpm vitest run' | 'pnpm exec vitest run' | 'pnpm -r test' | 'vitest run') echo test ;;
    'pnpm build:vercel' | 'pnpm run build:vercel') echo build ;;
    *) echo '' ;;
    esac
}

# Split on &&, ||, ; and newlines, then collect the gates each segment names.
gates=()
while IFS= read -r segment; do
    segment="$(echo "$segment" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [ -z "$segment" ] && continue
    gate="$(gate_of "$segment")"
    [ -n "$gate" ] && gates+=("$gate")
done < <(echo "$cmd" | sed -e 's/&&/\n/g' -e 's/||/\n/g' -e 's/;/\n/g')

if [ "${#gates[@]}" -eq 0 ]; then
    exit 0
fi

advise() {
    echo "blocked by project hook: ${1}" >&2
    echo "run: pnpm verify" >&2
    echo "  (typecheck -> eslint -> prettier -> vitest, fastest failure first)" >&2
    echo "command was: ${cmd}" >&2
    exit 2
}

if [ "${#gates[@]}" -ge 2 ]; then
    advise "${#gates[@]} quality gates chained by hand (${gates[*]})"
fi

case "${gates[0]}" in
test)
    echo "blocked by project hook: unscoped whole-repo test run" >&2
    echo "run: pnpm verify   (or scope it: pnpm exec vitest run path/to/one.test.ts)" >&2
    echo "command was: ${cmd}" >&2
    exit 2
    ;;
lint | format)
    echo "blocked by project hook: unscoped whole-repo ${gates[0]} run" >&2
    echo "run: pnpm verify   (or scope it: pnpm exec eslint <path>, pnpm exec prettier --check <path>)" >&2
    echo "command was: ${cmd}" >&2
    exit 2
    ;;
esac

exit 0
