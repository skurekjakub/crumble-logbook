#!/usr/bin/env bash
# Injects a short, periodic reminder of the project's highest-priority rules.
# Wired on UserPromptSubmit and on PostToolUse for the tools the rules govern;
# emits at most once per REMIND_INTERVAL_SECONDS (default 300) per agent, so the
# rules stay live inside long autonomous turns without flooding context.
#
# The rules live in .ai/reminders.md: every "- " bullet there is a rule, and
# every other line is ignored. Edit that file, not this script.
#
# Output: JSON with hookSpecificOutput.additionalContext (Claude Code shape).
# Falls back to `additional_context` top-level for compatible platforms.

set -euo pipefail

REMINDERS_FILE="${CLAUDE_PROJECT_DIR:-$(pwd)}/.ai/reminders.md"
[ -r "$REMINDERS_FILE" ] || exit 0

# The event name decides which output key Claude Code reads; a payload without
# one is treated as a user prompt.
payload=$(cat 2>/dev/null || true)
event=$(printf '%s' "$payload" | jq -r '.hook_event_name // empty' 2>/dev/null || true)
[ -n "$event" ] || event="UserPromptSubmit"

# Throttle on wall clock, not turn count: a single autonomous turn can run for
# many minutes of tool calls without a UserPromptSubmit ever firing.
# Keyed by session and subagent, never by cwd: the cwd changes with every `cd`
# and worktree, and each new one would open a fresh window. Per-agent keys give
# every running agent its own reminder.
REMIND_INTERVAL_SECONDS="${REMIND_INTERVAL_SECONDS:-300}"
session=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)
agent=$(printf '%s' "$payload" | jq -r '.agent_id // empty' 2>/dev/null || true)
key=$(printf '%s|%s' "${session:-$PWD}" "${agent:-main}" | cksum | cut -d' ' -f1)
state_dir="${HOME}/.claude/remind-rules"
state_file="${state_dir}/last-${key}"
lock_dir="${state_dir}/lock-${key}"
mkdir -p "$state_dir"

# Parallel tool calls fire this hook concurrently; without a lock they all read
# the old timestamp and all emit. mkdir is atomic, so the loser just skips.
mkdir "$lock_dir" 2>/dev/null || exit 0
trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT
now=$(date +%s)
last=$(cat "$state_file" 2>/dev/null || echo 0)
case "$last" in ''|*[!0-9]*) last=0 ;; esac
if [ $((now - last)) -lt "$REMIND_INTERVAL_SECONDS" ]; then
    exit 0
fi
printf '%s' "$now" > "$state_file"

# Sessions end without telling the hook; drop state older than a day.
find "$state_dir" -maxdepth 1 -name 'last-*' -mmin +1440 -delete 2>/dev/null || true

# CRLF from a Windows editor would leave a stray \r on every rule.
rules=$(grep -E '^- ' "$REMINDERS_FILE" | tr -d '\r' || true)
[ -n "$rules" ] || exit 0

reminder_text="HIGH-PRIORITY RULES (auto-injected periodically — edit .ai/reminders.md if outdated):
${rules}"

# Caveman mode reinforcement — the caveman plugin writes the active intensity to
# this user-scoped flag. Mirror it here so the reminder survives long turns where
# other injected context crowds the plugin's own per-turn line out of attention.
caveman_mode=$(cat "${HOME}/.claude/.caveman-active" 2>/dev/null || true)
if [ -n "$caveman_mode" ]; then
    reminder_text="${reminder_text}
- CAVEMAN MODE ACTIVE (${caveman_mode}) — stay compressed: drop articles/filler/pleasantries/hedging. Fragments OK. Code/commits/security: write normal."
fi

# Bash parameter-substitution JSON-escaper.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

reminder_escaped=$(escape_for_json "$reminder_text")

# Claude Code reads nested hookSpecificOutput and drops the block unless
# hookEventName matches the firing event; Cursor reads a flat top-level key.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    printf '{\n  "additional_context": "%s"\n}\n' "$reminder_escaped"
else
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "%s",\n    "additionalContext": "%s"\n  }\n}\n' "$event" "$reminder_escaped"
fi

exit 0
